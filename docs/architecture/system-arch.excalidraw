    {
      "id": "t1599851661",
      "type": "text",
      "x": 35,
      "y": 530,
      "width": 230,
      "height": 62.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 1205528894,
      "version": 1,
      "versionNonce": 1157444917,
      "isDeleted": false,
      "boundElements": null,
      "groupIds": [],
      "frameId": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Blue  = App / job lifecycle\nGreen = Bridge poll / result\nOrange = Admin / OIDC identity\nGrey (dashed) = control-plane R/W\nRed = Principal / routing (thesis)",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 50.0,
      "containerId": null,
      "originalText": "Blue  = App / job lifecycle\nGreen = Bridge poll / result\nOrange = Admin / OIDC identity\nGrey (dashed) = control-plane R/W\nRed = Principal / routing (thesis)",
      "lineHeight": 1.25
    },
    {
      "id": "t564233311",
      "type": "text",
      "x": 35,
      "y": 645,
      "width": 230,
      "height": 62.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 1604199940,
      "version": 1,
      "versionNonce": 1255388861,
      "isDeleted": false,
      "boundElements": null,
      "groupIds": [],
      "frameId": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Two central ideas:\n1. Principal split - auth (who) vs.\n   routing (where) - principal.go\n2. Per-user queue isolation -\n   jobUser[id]!=userID - queue.go",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 50.0,
      "containerId": null,
      "originalText": "Two central ideas:\n1. Principal split - auth (who) vs.\n   routing (where) - principal.go\n2. Per-user queue isolation -\n   jobUser[id]!=userID - queue.go",
      "lineHeight": 1.25
    },
