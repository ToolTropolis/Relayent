# Relayent relay — local Docker deployment.
# Copy to .env in deploy/, fill in, and keep it OUT of git.

# Legacy pairing key — optional for local testing. Generate:
#   docker compose -f docker-compose.local.yml run --rm relay keygen
RELAYENT_PAIRING_KEY=

# Bootstrap admin token — grants admin scope for the /admin dashboard.
# >=24 chars. Generate the same way as the pairing key.
RELAYENT_ADMIN_TOKEN=

# Session signing key — keeps admin sessions valid across container restarts.
# Any stable secret >=16 chars. Generate: head -c 36 /dev/urandom | base64
RELAYENT_SESSION_KEY=

# OIDC (optional; leave blank to use token auth only).
RELAYENT_OIDC_ISSUER=
RELAYENT_OIDC_CLIENT_ID=
RELAYENT_OIDC_CLIENT_SECRET=
RELAYENT_OIDC_REDIRECT_URL=
RELAYENT_OIDC_HOSTED_DOMAIN=

# Request body size cap in bytes (default 1 MiB). Raise this to allow bigger
# prompts/results, e.g. 4194304 for 4 MiB.
RELAYENT_MAX_BODY_BYTES=

# How long GET /v1/jobs/{id} blocks for a result, as a Go duration (default 90s).
RELAYENT_FETCH_WAIT=

# How long a job stays claimable before expiring, as a Go duration (default 10m).
RELAYENT_JOB_TTL=
